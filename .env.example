# Server config (see apps/server/src/config.ts). Copy to .env for local overrides.
NODE_ENV=development
PORT=3000

# Fixed-timestep sim loop for real-time mini-games (party games don't need 60).
TICK_HZ=20
# Publish a ROUND_STATE snapshot every N ticks.
SNAPSHOT_EVERY_N_TICKS=3

# Deterministic RNG seed for mini-game rolls (a determinism knob, NOT a secret).
RNG_SEED=1

# Browser origins allowed to open the WS upgrade (comma-separated). Fail-closed: empty outside
# development. In development the dev client origin is admitted when unset.
ALLOWED_ORIGINS=

# Close a socket after this many seconds of inactivity.
WS_IDLE_TIMEOUT_SEC=60

# Room lifecycle (in-memory only, Phase 1).
ROOM_CODE_LEN=4
# Up to 12 (the catalog ceiling); every game declares its own player range.
ROOM_MAX_PLAYERS=12
ROOM_IDLE_TIMEOUT_SEC=900
